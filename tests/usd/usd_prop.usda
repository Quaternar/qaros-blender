#usda 1.0
(
    defaultPrim = "Prop"
    metersPerUnit = 0.01
    upAxis = "Y"
)

# Referenced by usd_scene.usda: a cylinder shape (Blender's import drops a shape's binding) with a
# material of this layer's own.
def Xform "Prop"
{
    def Cylinder "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 30
        double radius = 15
        rel material:binding = </Prop/Looks/Green>
        double3 xformOp:translate = (0, 15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "Green"
        {
            token outputs:surface.connect = </Prop/Looks/Green/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.7, 0.2)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }
}
